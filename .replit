modules = ["nodejs-24", "rust-stable", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["sh", "scripts/prepare-deployment-outputs.sh"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
packages = ["cargo", "rustup", "openssl", "pkg-config", "dbus", "udev"]
channel = "stable-25_05"
