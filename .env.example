CONTRIBUTION_CONTRACT_ID=SET_AFTER_TESTNET_DEPLOY
ISSUER_PUBLIC_KEY=SET_AFTER_TESTNET_DEPLOY

# Secret keys must be supplied through a local secret manager.
# Never commit a value here.
